# Firebase web config. These are NOT secrets (the web apiKey only identifies the
# project; access is governed by Firestore/Storage Security Rules), but keeping
# them in env vars lets you point staging/prod at different Firebase projects.
#
# Local dev: copy to `.env` (or `.env.local`) — src/firebase.js falls back to the
# current project values if these are unset, so this is optional locally.
# Vercel: add each as a Project Environment Variable (all environments).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
