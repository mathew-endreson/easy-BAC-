rules_version = '2';

// EZBAC Cloud Storage rules. Storage isn't used by the app yet, but shipping
// locked-down defaults prevents an open bucket the moment it is enabled.
//
//  • Public content (course covers, resource images) under /public/**: world
//    readable, admin-writable.
//  • A student's own uploads under /users/{uid}/**: owner-writable, owner + admin
//    readable.
//  • Everything else: denied.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
